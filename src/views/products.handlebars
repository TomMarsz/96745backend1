<section class="container">
  <h2 class="page-title">Productos</h2>

  <div class="product-grid">
    {{#each response.payload}}
    <article class="product-card">
      <div class="product-thumb">{{category}}</div>
      <div class="product-body">
        <span class="badge">{{category}}</span>
        <h3 class="product-title">{{title}}</h3>
        <p class="product-desc">{{description}}</p>
        <div class="product-meta">
          <span class="price">${{price}}</span>
          <span class="stock {{#unless stock}}out{{/unless}}">
            {{#if stock}}Stock: {{stock}}{{else}}Sin stock{{/if}}
          </span>
        </div>
      </div>
      <div class="card-actions">
        <input type="number" class="qty-input" min="1" value="1" aria-label="Cantidad">
        <button
          class="btn btn-primary add-to-cart"
          data-id="{{_id}}"
          {{#unless stock}}disabled{{/unless}}>
          Agregar al carrito
        </button>
      </div>
    </article>
    {{/each}}
  </div>

  <div class="pagination">
    <a
      class="btn btn-ghost {{#unless response.hasPrevPage}}is-disabled{{/unless}}"
      href="/products?page={{response.prevPage}}">← Anterior</a>
    <span class="page-info">Página {{response.page}} de {{response.totalPages}}</span>
    <a
      class="btn btn-ghost {{#unless response.hasNextPage}}is-disabled{{/unless}}"
      href="/products?page={{response.nextPage}}">Siguiente →</a>
  </div>
</section>

<script src="/js/products.js" defer></script>
